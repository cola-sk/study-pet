# Supabase 连接配置 (在 Vercel 环境变量或本地 .env.local 中配置)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 仅服务端使用，绝不使用 NEXT_PUBLIC 前缀；不要提交真实密钥。
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# 固定且保密的 32 字节十六进制密钥；修改会更换全部家长配对码。
PAIRING_CODE_SECRET=your-64-character-random-hex-secret

# 注册邮件使用的站点地址（本地开发也默认使用正式域名）
NEXT_PUBLIC_SITE_URL=https://keep.1203.fyi
